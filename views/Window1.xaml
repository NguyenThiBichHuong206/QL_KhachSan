<Window x:Class="QLKhachsan.views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quan li khach san" Height="720" Width="1180"
        MinHeight="650" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#146C94"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0B3142"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#697586"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE5EE"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#D8E7EF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D5870"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="QL Khach San"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="Hotel Management"
                               Foreground="#9CC7D8"
                               Margin="0,4,0,26"/>

                    <Button Content="Tong quan" Background="#146C94" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Quan li phong" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Dat phong" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Khach hang" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Hoa don" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Dich vu" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="Bao cao" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="#123D50"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Le tan dang truc"
                                   Foreground="#9CC7D8"
                                   FontSize="12"/>
                        <TextBlock Text="Nguyen Minh Anh"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Bang dieu khien"
                               Foreground="#172033"
                               FontSize="30"
                               FontWeight="Bold"/>
                    <TextBlock Text="Theo doi phong, dat phong va doanh thu trong ngay"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Xuat bao cao"
                            Style="{StaticResource OutlineButtonStyle}"
                            Margin="0,0,10,0"/>
                    <Button Command="{Binding RefreshCommand}"
                            Content="Tai lai du lieu"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Phong trong" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding AvailableRoomCount}" Foreground="#172033" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Phong san sang" Foreground="#16835C" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Dang o" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding OccupiedRoomCount}" Foreground="#172033" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding OccupancyRateText}" Foreground="#146C94" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Cho nhan phong" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding WaitingCheckInCount}" Foreground="#172033" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Phong sap nhan khach" Foreground="#9A6A00" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Doanh thu ngay" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding DailyRevenueText}" Foreground="#172033" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Tinh theo phong dang o" Foreground="#16835C" FontSize="12"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,22,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Tinh trang phong"
                                           Foreground="#172033"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Cap nhat theo tang va hang phong"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox DockPanel.Dock="Right"
                                      Width="150"
                                      Height="34"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Tat ca tang"/>
                                <ComboBoxItem Content="Tang 1"/>
                                <ComboBoxItem Content="Tang 2"/>
                                <ComboBoxItem Content="Tang 3"/>
                            </ComboBox>
                        </DockPanel>

                        <DataGrid AutoGenerateColumns="False"
                                  ItemsSource="{Binding Rooms}"
                                  SelectedItem="{Binding SelectedRoom}"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeight="44"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#F8FBFE">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phong" Binding="{Binding RoomNumber}" Width="*"/>
                                <DataGridTextColumn Header="Loai" Binding="{Binding RoomType}" Width="1.5*"/>
                                <DataGridTextColumn Header="Trang thai" Binding="{Binding Status}" Width="1.4*"/>
                                <DataGridTextColumn Header="Gia / dem" Binding="{Binding PriceText}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.05*"/>
                        <RowDefinition Height="0.95*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Dat phong gan day"
                                       Foreground="#172033"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>

                            <ItemsControl ItemsSource="{Binding RecentBookings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#146C94" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Thao tac nhanh"
                                       Foreground="#172033"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Content="Nhan phong" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,10"/>
                                <Button Content="Tra phong" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,10"/>
                                <Button Content="Them khach" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                                <Button Content="Lap hoa don" Style="{StaticResource OutlineButtonStyle}"/>
                            </UniformGrid>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Visibility="{Binding ErrorVisibility}"
                                       Foreground="#B42318"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
