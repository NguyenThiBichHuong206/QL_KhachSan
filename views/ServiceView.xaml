<UserControl  x:Class="QLKhachSan.views.ServiceView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FORM DỊCH VỤ -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="THÔNG TIN DỊCH VỤ"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           Margin="0,0,0,8"/>

                <WrapPanel Grid.Row="1">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Tên dịch vụ"/>
                        <TextBox Width="190"
                                 Height="30"
                                 Padding="5"
                                 Text="{Binding TenDV, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Đơn giá"/>
                        <TextBox Width="120"
                                 Height="30"
                                 Padding="5"
                                 Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Hàng hóa liên kết"/>
                        <ComboBox Width="190"
                                  Height="30"
                                  ItemsSource="{Binding DanhSachHangHoaLuaChon}"
                                  SelectedValue="{Binding SelectedMaHang, Mode=TwoWay}"
                                  SelectedValuePath="MaHang"
                                  DisplayMemberPath="TenHang"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Số lượng tiêu hao"/>
                        <TextBox Width="120"
                                 Height="30"
                                 Padding="5"
                                 Text="{Binding SoLuongTieuHao, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,17,12,8">
                        <TextBlock Text="{Binding LoaiDichVuDangChonText}"
                                   FontWeight="Bold"
                                   Foreground="#475569"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Margin="0,4,0,0">

                    <Button Content="Thêm"
                            Command="{Binding AddCommand}"
                            Width="80"
                            Height="30"
                            Background="#10B981"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,6,0"
                            Cursor="Hand"/>

                    <Button Content="Sửa"
                            Command="{Binding UpdateCommand}"
                            Width="80"
                            Height="30"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="Bold"
                            Margin="0,0,6,0"
                            Cursor="Hand"/>

                    <Button Content="Xóa (Ngừng bán)"
                            Command="{Binding DeleteCommand}"
                            Width="130"
                            Height="30"
                            Background="#EF4444"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DANH SÁCH DỊCH VỤ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DanhSachDV}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Background="White"
                  RowHeight="35">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="5,0,5,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã DV"
                                    Binding="{Binding MaDV}"
                                    Width="65"/>

                <DataGridTextColumn Header="Tên dịch vụ"
                                    Binding="{Binding TenDV}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Đơn giá"
                                    Binding="{Binding DonGia, StringFormat={}{0:N0}}"
                                    Width="110"/>

                <DataGridTemplateColumn Header="Loại dịch vụ"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Có dùng kho"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MaHang}"
                                                         Value="{x:Null}">
                                                <Setter Property="Text" Value="Không dùng kho"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Hàng hóa liên kết"
                                    Binding="{Binding HangHoa.TenHang, TargetNullValue=Không có}"
                                    Width="150"/>

                <DataGridTemplateColumn Header="Tồn kho"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding HangHoa.SoLuongTon, TargetNullValue=Không áp dụng}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding HangHoa.DonViTinh}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="SL tiêu hao"
                                    Binding="{Binding SoLuongTieuHao}"
                                    Width="95"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>