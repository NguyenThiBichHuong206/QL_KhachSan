<UserControl x:Class="QLKhachSan.views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0"
                   Text="ĐẶT PHÒNG / NHẬN PHÒNG"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,15"/>

        <!-- FORM NHẬN PHÒNG -->
        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Khách hàng -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Khách hàng" FontWeight="Bold"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding DanhSachKhachHang}"
                              SelectedItem="{Binding SelectedKhachHang, Mode=TwoWay}"
                              DisplayMemberPath="HoTen"/>
                </StackPanel>

                <!-- Phòng trống -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Phòng trống" FontWeight="Bold"/>
                    <ComboBox Height="32"
                              ItemsSource="{Binding DanhSachPhongTrong}"
                              SelectedItem="{Binding SelectedPhong, Mode=TwoWay}"
                              DisplayMemberPath="TenPhong"/>
                </StackPanel>

                <!-- Ngày nhận phòng -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Ngày nhận phòng" FontWeight="Bold"/>
                    <DatePicker Height="32"
                                SelectedDate="{Binding NgayNhan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Nút nhận phòng -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="5" VerticalAlignment="Bottom">
                    <Button Content="Nhận phòng"
                            Width="120"
                            Height="34"
                            Command="{Binding TaoHoaDonCommand}"/>
                </StackPanel>

                <!-- Thông tin phòng -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Text="{Binding ThongTinPhongText}"
                           Foreground="#475569"
                           FontSize="13"
                           Margin="5,10,5,0"/>
            </Grid>
        </Border>

        <!-- TIÊU ĐỀ DANH SÁCH -->
        <TextBlock Grid.Row="2"
                   Text="DANH SÁCH HÓA ĐƠN CHƯA THANH TOÁN"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,10"/>

        <!-- DANH SÁCH HÓA ĐƠN ĐANG Ở -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding DanhSachHoaDonDangO}"
                  SelectedItem="{Binding SelectedHoaDon, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowHeight="38"
                  FontSize="14"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

            <DataGrid.Resources>
                <!-- Canh giữa tiêu đề cột -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0,8,0"/>
                </Style>

                <!-- Padding cho ô dữ liệu -->
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="6,0,6,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Mã HĐ"
                                    Binding="{Binding MaHD}"
                                    Width="80"
                                    CanUserSort="False"/>

                <DataGridTextColumn Header="Khách hàng"
                                    Binding="{Binding KhachHang.HoTen}"
                                    Width="220"
                                    CanUserSort="False"/>

                <DataGridTextColumn Header="Phòng"
                                    Binding="{Binding Phong.TenPhong}"
                                    Width="110"
                                    CanUserSort="False"/>

                <DataGridTextColumn Header="Ngày nhận"
                                    Binding="{Binding NgayCheckIn, StringFormat=dd/MM/yyyy}"
                                    Width="130"
                                    CanUserSort="False"/>

                <DataGridTextColumn Header="Tiền phòng"
                                    Binding="{Binding TienPhong, StringFormat=N0}"
                                    Width="130"
                                    CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Tiền dịch vụ"
                                    Binding="{Binding TienDichVu, StringFormat=N0}"
                                    Width="130"
                                    CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Tổng tiền"
                                    Binding="{Binding TongTien, StringFormat=N0}"
                                    Width="130"
                                    CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Thanh toán"
                                        Width="160"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Không xác định"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrangThaiThanhToan}" Value="0">
                                                <Setter Property="Text" Value="Chưa thanh toán"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding TrangThaiThanhToan}" Value="1">
                                                <Setter Property="Text" Value="Đã thanh toán"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>