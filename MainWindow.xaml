<Window x:Class="QLKhachSan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QLKhachSan.ViewModels"
        xmlns:views="clr-namespace:QLKhachSan.views"
        Title="Quản lý Khách sạn - Modern Style"
        Height="760"
        Width="1200"
        MinHeight="700"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#E4E9F2">

    <Window.Resources>
        <!-- BooleanToVisibility converter for toggling logout button -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Avatar ToggleButton style (circular) -->
        <Style x:Key="AvatarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="20"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4C1D95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- (existing DataTemplates and ModernMenuButtonStyle unchanged) -->
        <DataTemplate DataType="{x:Type vm:CheckoutViewModel}">
            <views:CheckoutView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <views:CustomerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RoomViewModel}">
            <views:RoomView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BookingViewModel}">
            <views:BookingView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
            <views:ServiceView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,19.93C7.05,19.43 4,16.05 4,12C4,7.95 7.05,4.57 11,4.07V19.93M13,4.07C16.95,4.57 20,7.95 20,12C20,16.05 16.95,19.43 13,19.93V4.07Z"
                      Fill="#CBD5E1" Width="80" Height="80" Stretch="Fill" Margin="0,0,0,20"/>
                <TextBlock Text="{Binding Message}" FontSize="28" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center"/>
                <TextBlock Text="Khu vực này đang được phát triển." FontSize="15" Foreground="#64748B" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ModernMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="24" Margin="0,0,15,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E1E38" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.15"/>
            </Border.Effect>

            <DockPanel LastChildFill="True" Margin="20,30,20,20">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Border Width="12" Height="12" CornerRadius="6" Background="#4F46E5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GreetingText, FallbackValue='Xin chào!'}" Foreground="White" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Hệ thống Quản lý Khách sạn" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" Margin="22,0,0,0"/>
                </StackPanel>

                <!-- Bottom area: avatar toggle + user info + logout (toggled) -->
                <Border DockPanel.Dock="Bottom" Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar as ToggleButton: click to show/hide logout -->
                        <ToggleButton x:Name="AvatarToggle"
                                      Grid.Column="0"
                                      Style="{StaticResource AvatarToggleStyle}"
                                      ToolTip="Tùy chọn tài khoản">
                            <TextBlock Text="NV" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- User info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                            <TextBlock Text="{Binding CurrentUserName, FallbackValue='Nhân viên'}" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentUserRole, FallbackValue='Lễ tân'}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Logout button appears when AvatarToggle.IsChecked == True -->
                        <Button Grid.Column="2"
                                Content="Đăng xuất"
                                Command="{Binding LogoutCommand}"
                                Visibility="{Binding IsChecked, ElementName=AvatarToggle, Converter={StaticResource BoolToVis}}"
                                Background="Transparent"
                                Foreground="#EF4444"
                                BorderThickness="0"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Margin="0,0,4,0"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <!-- Admin-only: Dashboard -->
                        <Button Content="Tổng quan" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowDashboardCommand}" Visibility="{Binding AdminMenuVisibility}"/>
                        <!-- Admin-only: Room -->
                        <Button Content="Quản lý phòng" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowRoomCommand}" Visibility="{Binding AdminMenuVisibility}"/>
                        <!-- Always visible: Booking -->
                        <Button Content="Đặt phòng" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowBookingCommand}"/>
                        <!-- Always visible: Customer -->
                        <Button Content="Khách hàng" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowCustomerCommand}"/>
                        <!-- Always visible: Invoice/Checkout -->
                        <Button Content="Hóa đơn" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowInvoiceCommand}"/>
                        <!-- Admin-only: Service -->
                        <Button Content="Dịch vụ" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowServiceCommand}" Visibility="{Binding AdminMenuVisibility}"/>

                        <!--Nhập kho  (Admin-only) -->
                        <Button Content="Nhập kho" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowInventoryCommand}" Visibility="{Binding AdminMenuVisibility}"/>

                        <!-- Admin-only: Report -->
                        <Button Content="Báo cáo" Style="{StaticResource ModernMenuButtonStyle}" Command="{Binding ShowReportCommand}" Visibility="{Binding AdminMenuVisibility}"/>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,20,0,25">
                <TextBlock Text="{Binding PageTitle, FallbackValue='Tổng quan'}" FontSize="34" FontWeight="Black" Foreground="#1E293B"/>
                <TextBlock Text="{Binding PageDescription, FallbackValue='Hệ thống hỗ trợ quản lý vận hành khách sạn'}" FontSize="14" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="24" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#8CA3BA" BlurRadius="25" ShadowDepth="10" Opacity="0.2"/>
                </Border.Effect>
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>